{
  "name": "motion-sdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test": "pnpm run check:boundaries && node --test tests/*.test.ts",
    "build:examples": "node examples/build-variants.ts"
  },
  "dependencies": {
    "@motion-sdk/core": "workspace:*",
    "@motion-sdk/remotion": "workspace:*",
    "motion-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
